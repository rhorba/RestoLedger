# Database — local dev via docker-compose (see root docker-compose.yml)
DATABASE_URL="postgresql://restoledger:restoledger_dev_only@localhost:5433/restoledger?schema=public"

# App
PORT=3000
NODE_ENV=development

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
