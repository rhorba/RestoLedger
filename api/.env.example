# Owner connection — used ONLY by `prisma migrate` (schema DDL, role creation)
DATABASE_URL="postgresql://restoledger:restoledger_dev_only@localhost:5433/restoledger?schema=public"

# App runtime connection — non-superuser role, subject to RLS (see prisma/migrations/*_row_level_security)
# Local dev password matches the migration's dev-only default. Staging/prod: rotate via
# `ALTER ROLE restoledger_app PASSWORD '<secret>'` after deploy — never trust the migration default outside dev.
APP_DATABASE_URL="postgresql://restoledger_app:restoledger_app_dev_only@localhost:5433/restoledger?schema=public"

# App
PORT=3000
NODE_ENV=development

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Seconds (not duration strings — keeps the TS types simple: number | StringValue, we always pass number)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
